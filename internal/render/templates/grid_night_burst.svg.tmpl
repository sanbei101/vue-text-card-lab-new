{{ define "grid" }}<svg class="block h-auto w-full overflow-visible" viewBox="0 0 900 1200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{svgEscape .Template.Name}}">
  <defs>
    <pattern id="grid-{{.Template.ID}}" width="52" height="52" patternUnits="userSpaceOnUse">
      <path d="M 52 0 L 0 0 0 52" fill="none" stroke="{{.Template.Muted}}" stroke-width="2" opacity="0.48"/>
    </pattern>
  </defs>

  <!-- 背景（网格图案） -->
  <rect x="18" y="18" width="864" height="1164" rx="{{f .Template.Radius}}" fill="url(#grid-{{.Template.ID}})"/>

  <!-- 蓝图网格装饰 -->
  <g>
    <circle cx="740" cy="190" r="115" fill="none" stroke="{{.Template.Accent}}" stroke-width="18" opacity="0.18"/>
    <path d="M90 1020 H810" stroke="{{.Template.Accent}}" stroke-width="8"/>
    <path d="M90 1052 H570" stroke="{{.Template.Foreground}}" stroke-width="3" opacity="0.7"/>
  </g>

  {{ template "highlight_layer" . }}
  {{ template "main_text" . }}
  {{ template "card_signature" . }}
</svg>
{{ end }}

{{ define "night" }}<svg class="block h-auto w-full overflow-visible" viewBox="0 0 900 1200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{svgEscape .Template.Name}}">
  <!-- 背景 -->
  <rect x="18" y="18" width="864" height="1164" rx="{{f .Template.Radius}}" fill="{{.Template.Background}}"/>

  <!-- 深夜星光装饰 -->
  <g>
    <circle cx="710" cy="220" r="116" fill="{{.Template.Accent}}" opacity="0.96"/>
    <circle cx="755" cy="185" r="120" fill="{{.Template.Background}}"/>
    {{ range $i, $p := .Particles }}
    <g transform="translate({{f $p.X}} {{f $p.Y}})" fill="{{if eq (mod $i 3) 0}}{{$.Template.Accent}}{{else}}{{$.Template.Foreground}}{{end}}" opacity="{{f (add 0.25 (mul (modf (float $i) 4) 0.14))}}">
      {{ if mod $i 2 }}
      <circle r="{{f (div $p.Size 4)}}"/>
      {{ else }}
      <path d="M0 -11 L3 -3 L11 0 L3 3 L0 11 L-3 3 L-11 0 L-3 -3 Z"/>
      {{ end }}
    </g>
    {{ end }}
    <path d="M135 980 C315 900 590 1070 770 955" fill="none" stroke="{{.Template.Muted}}" stroke-width="4"/>
  </g>

  {{ template "highlight_layer" . }}
  {{ template "main_text" . }}
  {{ template "card_signature" . }}
</svg>
{{ end }}

{{ define "burst" }}<svg class="block h-auto w-full overflow-visible" viewBox="0 0 900 1200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{svgEscape .Template.Name}}">
  <!-- 背景 -->
  <rect x="18" y="18" width="864" height="1164" rx="{{f .Template.Radius}}" fill="{{.Template.Background}}"/>

  <!-- 橙色爆炸装饰 -->
  <g>
    <g stroke="{{.Template.Accent}}" stroke-width="18" stroke-linecap="round" opacity="0.78">
      <line x1="450" y1="90" x2="450" y2="180"/>
      <line x1="720" y1="160" x2="660" y2="230"/>
      <line x1="815" y1="430" x2="720" y2="430"/>
      <line x1="720" y1="980" x2="655" y2="900"/>
      <line x1="180" y1="980" x2="245" y2="900"/>
      <line x1="80" y1="430" x2="175" y2="430"/>
      <line x1="180" y1="160" x2="245" y2="230"/>
    </g>
    <path d="M450 155 L525 270 L660 245 L650 385 L785 450 L670 540 L720 675 L575 690 L520 825 L405 740 L285 830 L240 690 L95 675 L145 535 L30 450 L165 385 L150 245 L285 270 Z" fill="#ffb778" opacity="0.34"/>
  </g>

  {{ template "highlight_layer" . }}
  {{ template "main_text" . }}
  {{ template "card_signature" . }}
</svg>
{{ end }}
