{{- define "main_text" -}}
<g fill="{{.Template.Foreground}}" font-family="{{.Template.FontFamily}}" font-weight="{{.Template.FontWeight}}" text-anchor="{{.TextAnchor}}">
{{- range $i, $line := .Layout.Lines }}
<text x="{{f $.TextX}}" y="{{f (add $.Template.TextBox.Y (add $.Layout.FontSize (mul (float $i) $.Layout.LineHeightPx))) }}" font-size="{{f $.Layout.FontSize}}" dominant-baseline="alphabetic">{{svgEscape $line}}</text>
{{- end }}
</g>
{{- end -}}

{{- define "highlight_layer" -}}
{{- $opacity := .HighlightOpacity }}{{ if eq $opacity 0.0 }}{{ $opacity = 0.78 }}{{ end }}
{{- range $i, $rect := .Highlights }}
<g transform="rotate({{f $rect.Rotation}} {{f (add $rect.X (div $rect.Width 2))}} {{f (add $rect.Y (div $rect.Height 2))}})">
  <rect x="{{f $rect.X}}" y="{{f $rect.Y}}" width="{{f $rect.Width}}" height="{{f $rect.Height}}" rx="{{f (min 18 (div $rect.Height 2))}}" fill="{{$.Template.Accent}}" opacity="{{f $opacity}}"/>
</g>
{{- end }}
{{- end -}}

{{- define "card_signature" -}}
<g fill="{{.Template.Foreground}}" opacity="0.62">
  <circle cx="112" cy="1078" r="18"/>
  <text x="145" y="1087" font-size="24" font-family="{{.Template.FontFamily}}" font-weight="600">此刻想说</text>
</g>
{{- end -}}

