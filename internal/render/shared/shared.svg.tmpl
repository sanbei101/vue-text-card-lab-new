{{- define "main_text" -}}
<g fill="{{.Template.Foreground}}">
{{- range $line := .Lines }}
  <g transform="translate({{f $line.X}} {{f $line.Y}})">
    <path d="{{$line.Path}}" fill="{{$.Template.Foreground}}"/>
  </g>
{{- end }}
</g>
{{- end -}}

{{- define "highlight_layer" -}}
{{- $opacity := .HighlightOpacity }}{{ if eq $opacity 0.0 }}{{ $opacity = 0.78 }}{{ end }}
{{- range $i, $rect := .Highlights }}
<g transform="rotate({{f $rect.Rotation}} {{f (add $rect.X (div $rect.Width 2))}} {{f (add $rect.Y (div $rect.Height 2))}})">
  <rect x="{{f $rect.X}}" y="{{f $rect.Y}}" width="{{f $rect.Width}}" height="{{f $rect.Height}}" rx="{{f (min 18 (div $rect.Height 2))}}" fill="{{$.Template.Accent}}" opacity="{{f $opacity}}"/>
</g>
{{- end }}
{{- end -}}

{{- define "card_signature" -}}
<g fill="{{.Template.Foreground}}" opacity="0.62">
  <circle cx="112" cy="1078" r="18"/>
  <g transform="translate(145 1087)">
    <path d="{{.SignaturePath}}" fill="{{.Template.Foreground}}"/>
  </g>
</g>
{{- end -}}

{{- define "particle_star" -}}M0 -14 L4 -4 L14 0 L4 4 L0 14 L-4 4 L-14 0 L-4 -4 Z{{- end -}}

